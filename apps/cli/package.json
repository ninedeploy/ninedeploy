{
  "name": "ninedeploy",
  "version": "0.7.6",
  "description": "Interactive CLI for NineDeploy self-hosted PaaS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NineDeploy/NineDeploy.git",
    "directory": "apps/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "ninedeploy": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ninedeploy/sdk": "workspace:*",
    "@ninedeploy/schemas": "workspace:*",
    "commander": "^15.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
