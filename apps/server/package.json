{
  "name": "@ninedeploy/server",
  "version": "0.15.5",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist .turbo .data",
    "templates:mirror": "tsx scripts/buildTemplateMirror.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.1",
    "@ninedeploy/db": "workspace:*",
    "@ninedeploy/schemas": "workspace:*",
    "@ninedeploy/sdk": "workspace:*",
    "@node-rs/argon2": "^2.1.0",
    "@simplewebauthn/server": "^14.0.3",
    "croner": "^10.0.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "js-yaml": "^4.3.2",
    "nodemailer": "^10.0.12",
    "pm2": "^7.0.4",
    "simple-git": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
