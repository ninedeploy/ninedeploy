diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..bfa645d44d86351b715c4858b46bc7b2c899dbd5
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,17 @@
+'use strict';
+
+// Bound recursive walkers even when a caller supplies an AST directly.
+const MAX_DEPTH = 256;
+const depthError = () => new SyntaxError(`Maximum nesting depth exceeded (${MAX_DEPTH})`);
+
+const validateDepth = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  while (pending.length > 0) {
+    const { node, depth } = pending.pop();
+    if (!node || !Array.isArray(node.nodes)) continue;
+    if (depth > MAX_DEPTH) throw depthError();
+    for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+  }
+};
+
+module.exports = { MAX_DEPTH, depthError, validateDepth };
