{
  "name": "@ninedeploy/mcp",
  "version": "0.7.9",
  "description": "Official Model Context Protocol (MCP) server for NineDeploy AI integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NineDeploy/NineDeploy.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "ninedeploy-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@ninedeploy/schemas": "workspace:*",
    "@ninedeploy/sdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
