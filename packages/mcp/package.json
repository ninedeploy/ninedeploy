{
  "name": "@ninedeploy/mcp",
  "version": "0.18.26",
  "description": "Official Model Context Protocol (MCP) server for NineDeploy AI integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ninedeploy/ninedeploy.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "bin": {
    "ninedeploy-mcp": "./bin/ninedeploy-mcp.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ninedeploy/sdk": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
