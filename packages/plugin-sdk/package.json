{
  "name": "@ninedeploy/plugin-sdk",
  "version": "0.7.6",
  "description": "Plugin development kit for NineDeploy microkernel and driver registries",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NineDeploy/NineDeploy.git",
    "directory": "packages/plugin-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ninedeploy/schemas": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
