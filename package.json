{
  "name": "ninedeploy-monorepo",
  "version": "0.10.35",
  "private": true,
  "description": "Self-hosted, one-click deployment platform with PM2 + Docker, Traefik, webhooks, secrets, backups and monitoring.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @ninedeploy/server dev",
    "dev:web": "pnpm --filter @ninedeploy/web dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ninedeploy/db db:generate",
    "db:migrate": "pnpm --filter @ninedeploy/db db:migrate",
    "templates:verify-images": "node scripts/verify-template-images.mjs",
    "templates:smoke-runtime": "node scripts/smoke-template-runtime.mjs",
    "docker:smoke-registry-recovery": "pnpm --filter @ninedeploy/server build && node scripts/smoke-registry-recovery.mjs",
    "db:studio": "pnpm --filter @ninedeploy/db db:studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "release:check": "pnpm typecheck && pnpm lint && pnpm build && pnpm turbo run test --concurrency=1",
    "release:tag": "node scripts/tag-release.js",
    "version:bump": "node scripts/bump-version.js",
    "release": "pnpm release:check && pnpm -r --filter \"./packages/*\" --filter \"./apps/cli\" publish --access public",
    "packages:publish": "pnpm -r --filter \"./packages/*\" --filter \"./apps/cli\" publish --access public",
    "smoke:user-journey": "node scripts/smoke-user-journey.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.0",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
