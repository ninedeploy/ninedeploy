{
  "name": "ninedeploy-monorepo",
  "version": "0.18.12",
  "private": true,
  "description": "Self-hosted, one-click deployment platform with PM2 + Docker, Traefik, webhooks, secrets, backups and monitoring.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @ninedeploy/server dev",
    "dev:web": "pnpm --filter @ninedeploy/web dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ninedeploy/db db:generate",
    "db:migrate": "pnpm --filter @ninedeploy/db db:migrate",
    "templates:verify-images": "node scripts/verify-template-images.mjs",
    "templates:smoke-runtime": "node scripts/smoke-template-runtime.mjs",
    "docker:smoke-registry-recovery": "pnpm --filter @ninedeploy/server build && node scripts/smoke-registry-recovery.mjs",
    "db:studio": "pnpm --filter @ninedeploy/db db:studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "runtime:check": "node scripts/check-node-version.mjs",
    "release:check": "node scripts/check-node-version.mjs && pnpm typecheck && pnpm lint && pnpm build && pnpm turbo run test --concurrency=1",
    "release:tag": "node scripts/tag-release.js",
    "version:bump": "node scripts/bump-version.js",
    "release": "pnpm release:check && pnpm -r --filter \"./packages/*\" --filter \"./apps/cli\" publish --access public",
    "packages:publish": "pnpm -r --filter \"./packages/*\" --filter \"./apps/cli\" publish --access public",
    "smoke:user-journey": "node scripts/smoke-user-journey.mjs",
    "smoke:upgrade": "node scripts/smoke-upgrade.mjs",
    "smoke:multinode": "node scripts/smoke-multinode.mjs",
    "smoke:container-readiness": "node scripts/smoke-container-readiness.mjs",
    "smoke:local-docker-readiness": "node scripts/smoke-local-docker-readiness.mjs",
    "smoke:container-metrics": "node scripts/smoke-container-metrics.mjs",
    "smoke:container-lifecycle": "node scripts/smoke-container-lifecycle.mjs",
    "smoke:container-generation-stop": "node scripts/smoke-container-generation-stop.mjs",
    "smoke:agent-creation-drain": "node scripts/smoke-agent-creation-drain.mjs",
    "smoke:runtime-mutations": "node scripts/smoke-runtime-mutations.mjs",
    "smoke:node-lifecycle": "node scripts/smoke-node-lifecycle-controller.mjs",
    "smoke:node-lifecycle-fanout": "node scripts/smoke-node-lifecycle-fanout.mjs",
    "smoke:node-canary": "node scripts/smoke-node-canary.mjs",
    "smoke:node-limits": "node scripts/smoke-node-limits.mjs",
    "smoke:volume-files": "node scripts/smoke-volume-file-helper.mjs",
    "smoke:database-clients": "node scripts/smoke-database-clients.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.0",
    "pg": "8.23.1",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
